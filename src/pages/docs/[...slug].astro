---
import DocsLayout from '../../layouts/DocsLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const sidebarContent = fs.readFileSync(path.resolve('sidebar.json'), 'utf-8');
  const sidebar = JSON.parse(sidebarContent);
  
  const paths = new Set();
  const extractPaths = (items) => {
    items.forEach(group => {
      group.items.forEach(item => {
        let slug = item.path.replace('docs/zh-cn/', '').replace('docs/', '').replace(/\.md$/, '');
        paths.add(slug);
      });
    });
  };

  extractPaths(sidebar.en);
  extractPaths(sidebar.zh);

  return Array.from(paths).map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;

// Read all docs using Vite's import.meta.glob
const allDocs = Object.values(import.meta.glob('../../../docs/**/*.md', { eager: true }));

const enPathMatch = `docs/${slug}.md`;
const zhPathMatch = `docs/zh-cn/${slug}.md`;

const enDoc = allDocs.find(doc => doc.file.replace(/\\/g, '/').endsWith(enPathMatch));
const zhDoc = allDocs.find(doc => doc.file.replace(/\\/g, '/').endsWith(zhPathMatch));

const EnContent = enDoc ? enDoc.Content : null;
const ZhContent = zhDoc ? zhDoc.Content : null;
---

<DocsLayout slug={slug}>
  <article data-lang="en" class="markdown-content">
    {EnContent ? <EnContent /> : <p>English content not found for this route.</p>}
  </article>
  
  <article data-lang="zh" class="markdown-content" style="display:none;">
    {ZhContent ? <ZhContent /> : <p>此路由未找到中文内容。</p>}
  </article>
</DocsLayout>
