---
import BaseLayout from './BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const { slug } = Astro.props;

const sidebarContent = fs.readFileSync(path.resolve('sidebar.json'), 'utf-8');
const sidebarData = JSON.parse(sidebarContent);

function getCleanHash(p) {
  return p.replace("docs/zh-cn/", "").replace("docs/", "").replace(/\.md$/, "");
}
---

<BaseLayout title="BetterLyrics Documentation" showNavLogo={true}>
  <div class="docs-container">
    <aside class="sidebar reveal active" transition:persist="sidebar">
      <nav id="sidebar-nav">
        <!-- English Sidebar -->
        <div class="sidebar-lang-en">
          {sidebarData.en.map((group) => (
            <div>
              <h3 class="sidebar-group-title">
                <span>{group.category}</span>
                <svg viewBox="0 0 24 24" class="chevron" style="width:14px; height:14px; transition: transform 0.2s; transform: rotate(0deg);">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </h3>
              <ul>
                {group.items.map((item) => {
                  const cleanPath = getCleanHash(item.path);
                  const isActive = cleanPath === slug;
                  return (
                    <li>
                      <a href={`/docs/${cleanPath}`} class={isActive ? "active" : ""}>
                        <span class="nav-title-text">{item.title}</span>
                        {item.badge && (
                          <span class={`nav-badge nav-badge-${item.badge.variant}`}>{item.badge.text}</span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>

        <!-- Chinese Sidebar -->
        <div class="sidebar-lang-zh" style="display:none;">
          {sidebarData.zh.map((group) => (
            <div>
              <h3 class="sidebar-group-title">
                <span>{group.category}</span>
                <svg viewBox="0 0 24 24" class="chevron" style="width:14px; height:14px; transition: transform 0.2s; transform: rotate(0deg);">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </h3>
              <ul>
                {group.items.map((item) => {
                  const cleanPath = getCleanHash(item.path);
                  const isActive = cleanPath === slug;
                  return (
                    <li>
                      <a href={`/docs/${cleanPath}`} class={isActive ? "active" : ""}>
                        <span class="nav-title-text">{item.title}</span>
                        {item.badge && (
                          <span class={`nav-badge nav-badge-${item.badge.variant}`}>{item.badge.text}</span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </nav>
    </aside>
    
    <main class="content-area reveal active">
      <div id="markdown-content" style="opacity: 1;">
        <slot />
      </div>
    </main>
  </div>

  <style>
    .sidebar-group-title {
      margin: 1rem 0 0.5rem 0;
      font-size: 0.9rem;
      opacity: 0.6;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
    }
  </style>

  <script is:inline>
    // Handle Sidebar Collapsing
    document.querySelectorAll('.sidebar-group-title').forEach(title => {
      title.addEventListener('click', () => {
        const ul = title.nextElementSibling;
        const chevron = title.querySelector('.chevron');
        if (ul.style.display === "none") {
          ul.style.display = "block";
          chevron.style.transform = "rotate(0deg)";
          title.style.opacity = "0.6";
        } else {
          ul.style.display = "none";
          chevron.style.transform = "rotate(-90deg)";
          title.style.opacity = "0.4";
        }
      });
    });
  </script>
</BaseLayout>
